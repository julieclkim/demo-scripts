<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Patient Profile</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #ffffff;
      --surface: #ffffff;
      --surface-soft: #f7f8fa;
      --border: #e6e8ec;
      --text: #202124;
      --text-secondary: #61666c;
      --text-muted: #8a8f98;
      --accent: #4856d6;
      --accent-hover: #3e49bc;
      --success: #26734d;

      --radius: 8px;
      --font:
        Inter,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }

    body {
      padding: clamp(12px, 3vw, 20px);
    }

    .page {
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
    }

    /* HEADER */

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }

    .header-copy {
      min-width: 0;
    }

    .eyebrow {
      margin: 0 0 4px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(18px, 4vw, 22px);
      font-weight: 650;
      letter-spacing: -0.02em;
    }

    .status {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 8px;
      border-radius: 999px;
      background: #eef7f2;
      color: var(--success);
      font-size: 11px;
      font-weight: 650;
      white-space: nowrap;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    /* PATIENT */

    .patient {
      padding: 20px 0 16px;
    }

    .patient-name {
      margin: 0;
      font-size: clamp(21px, 5vw, 27px);
      font-weight: 650;
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .patient-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      margin-top: 7px;
      color: var(--text-secondary);
      font-size: 12px;
    }

    .meta-item {
      white-space: nowrap;
    }

    /* INFO */

    .section {
      border-top: 1px solid var(--border);
      padding: 16px 0;
    }

    .section-title {
      margin: 0 0 12px;
      color: var(--text-secondary);
      font-size: 12px;
      font-weight: 650;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 24px;
    }

    .field {
      min-width: 0;
    }

    .label {
      margin-bottom: 3px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 550;
    }

    .value {
      color: var(--text);
      font-size: 13px;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    /* INTERACTION CONTEXT */

    .context {
      background: var(--surface-soft);
      border-radius: var(--radius);
      padding: 13px 14px;
    }

    .context-label {
      margin-bottom: 4px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 600;
    }

    .context-value {
      font-size: 13px;
      line-height: 1.45;
    }

    /* ACTIONS */

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding-top: 4px;
    }

    button {
      appearance: none;
      min-height: 36px;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 13px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition:
        background 120ms ease,
        border-color 120ms ease,
        transform 80ms ease;
    }

    button:hover {
      background: var(--surface-soft);
      border-color: #d5d8dd;
    }

    button:active {
      transform: translateY(1px);
    }

    button.primary {
      border-color: var(--accent);
      background: var(--accent);
      color: #ffffff;
    }

    button.primary:hover {
      border-color: var(--accent-hover);
      background: var(--accent-hover);
    }

    /* CONFIRMATION */

    .confirmation {
      display: none;
      margin-top: 10px;
      color: var(--success);
      font-size: 11px;
      font-weight: 600;
    }

    .confirmation.visible {
      display: block;
    }

    /* MOBILE / NARROW AGENT SCRIPT */

    @media (max-width: 480px) {
      body {
        padding: 12px;
      }

      .header {
        align-items: flex-start;
      }

      .info-grid {
        grid-template-columns: 1fr;
        gap: 11px;
      }

      .actions {
        flex-direction: column;
      }

      button {
        width: 100%;
      }
    }

    @media (max-width: 320px) {
      .status {
        display: none;
      }
    }
  </style>
</head>

<body>

  <main class="page">

    <!-- HEADER -->
    <header class="header">
      <div class="header-copy">
        <p class="eyebrow">Patient Profile</p>
        <h1>Patient Context</h1>
      </div>

      <div class="status">
        <span class="status-dot"></span>
        Record loaded
      </div>
    </header>

    <!-- PATIENT IDENTITY -->
    <section class="patient">
      <h2 class="patient-name">Rick Sanchez</h2>

      <div class="patient-meta">
        <span class="meta-item">MRN 48291736</span>
        <span class="meta-item">DOB 03/14/1962</span>
      </div>
    </section>

    <!-- HIGH LEVEL INFO -->
    <section class="section">
      <h3 class="section-title">Patient information</h3>

      <div class="info-grid">

        <div class="field">
          <div class="label">Phone</div>
          <div class="value">(512) 555-0184</div>
        </div>

        <div class="field">
          <div class="label">Preferred language</div>
          <div class="value">English</div>
        </div>

        <div class="field">
          <div class="label">Patient status</div>
          <div class="value">Active</div>
        </div>

        <div class="field">
          <div class="label">Primary care</div>
          <div class="value">Established patient</div>
        </div>

      </div>
    </section>

    <!-- CURRENT CONTACT -->
    <section class="section">
      <h3 class="section-title">Current interaction</h3>

      <div class="context">
        <div class="context-label">Reason for contact</div>
        <div class="context-value">
          Appointment scheduling and patient account assistance
        </div>
      </div>
    </section>

    <!-- ACTIONS -->
    <section class="section">
      <h3 class="section-title">Agent actions</h3>

      <div class="actions">
        <button
          class="primary"
          type="button"
          onclick="handleAction('Patient record opened')"
        >
          Open Patient Record
        </button>

        <button
          type="button"
          onclick="handleAction('Scheduling workflow opened')"
        >
          Schedule Appointment
        </button>

        <button
          type="button"
          onclick="handleAction('Patient information updated')"
        >
          Update Information
        </button>
      </div>

      <div
        id="confirmation"
        class="confirmation"
        aria-live="polite"
      ></div>
    </section>

  </main>

  <script>
    function handleAction(message) {
      const confirmation = document.getElementById("confirmation");

      confirmation.textContent = "✓ " + message;
      confirmation.classList.add("visible");

      window.clearTimeout(window.confirmationTimer);

      window.confirmationTimer = window.setTimeout(() => {
        confirmation.classList.remove("visible");
      }, 2500);
    }
  </script>

</body>
</html>
